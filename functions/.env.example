# Copy to functions/.env (never commit .env). Comma-separated verified emails allowed to claim the first Admin owner.
ADMIN_BOOTSTRAP_EMAILS=
# Set to true once App Check (reCAPTCHA Enterprise) is configured for the web app.
ENFORCE_APP_CHECK=false
# Call centre (AI voice agents -> https function agentApi). Comma-separated keys "id:secret:scopes", secret >= 24 random
# characters (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`), scopes separated by |
# from: lookup catalog requests.create requests.read requests.cancel complaints handoff calls calls.read   (* = all).
# Example shape only - never commit real values: AGENT_API_KEYS=voicebot1:<secret>:lookup|catalog|requests.create|requests.read|requests.cancel|complaints|handoff|calls
AGENT_API_KEYS=
# Optional: requests per minute per agent key / employee (default 120).
AGENT_RATE_PER_MIN=
